---
import Toaster from 'sonner-astro/Toaster.astro';
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'sonner-astro — opinionated toast component for Astro',
  description = 'An opinionated toast component for Astro, ported from emilkowalski/sonner. Beautiful, accessible, and customizable notifications.',
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? 'https://sonner-astro.vercel.app/';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = new URL('/og.png', siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="sonner-astro" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    <script is:inline>
      // Prevent dark-mode FOUC: apply saved theme before first paint.
      try {
        var t = localStorage.getItem('sonner-theme');
        var resolved = t === 'system'
          ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : t;
        if (resolved === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch (_) {}
    </script>
  </head>
  <body>
    <main class="max-w-160 mx-auto px-8">
      <slot />
    </main>
    <Toaster position="bottom-right" />
  </body>
</html>
