{
  "name": "sonner-astro",
  "version": "0.1.2",
  "description": "An opinionated toast component for Astro.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "astro",
    "toast",
    "notifications",
    "ui",
    "sonner"
  ],
  "homepage": "https://github.com/mateogasme/sonner-astro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateogasme/sonner-astro.git"
  },
  "bugs": {
    "url": "https://github.com/mateogasme/sonner-astro/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Toaster.astro": "./components/Toaster.astro",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "components",
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "astro": "^6.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "astro check",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "astro": "^6.1.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
